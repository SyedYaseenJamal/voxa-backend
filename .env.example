# ── Server ─────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB ─────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxxx.mongodb.net/voxa?appName=Cluster0

# ── JWT ─────────────────────────────────────────
ACCESS_TOKEN_SECRET=change_me_in_production
REFRESH_TOKEN_SECRET=change_me_in_production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── SIP / Asterisk ───────────────────────────────
NEXT_PUBLIC_SIP_URI=
NEXT_PUBLIC_SIP_PASSWORD=
NEXT_PUBLIC_SIP_WSS_URL=ws://YOUR_ASTERISK_IP:8088/ws
ASTERISK_API_URL=http://YOUR_ASTERISK_IP/api/sendcall.php

# ── LiveKit ──────────────────────────────────────
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_WS_URL=ws://your-livekit-host:7880
LIVEKIT_HTTP_URL=http://your-livekit-host:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://your-livekit-host:7880
ROOM_NAME=phone-room

# ── Meta / WhatsApp ──────────────────────────────
META_WEBHOOK_VERIFY_TOKEN=change_me_in_production

# ── OBD CMS ─────────────────────────────────────
OBD_BASE_URL=http://YOUR_OBD_HOST/obd_cms/public
OBD_USERNAME=admin
OBD_PASSWORD=change_me_in_production
